# Copy to .env for local (non-Docker) runs. Docker compose sets these itself.

# Column that marks a table as tenant-governed. Tables without it are public.
QG_TENANT_COLUMN=tenant_id

# Column-level security: mask columns the catalog marks (dbt column meta).
QG_MASKING_ENABLED=true
QG_PII_UNMASK_ROLE=pii_reader

# Server
QG_HOST=0.0.0.0
QG_PORT=8765
QG_ENV=local
QG_SERVICE_NAME=querygate

# Clamped server-side regardless of what the agent asks for. The tool schemas
# advertise the same numbers.
QG_DEFAULT_ROW_LIMIT=100
QG_MAX_ROW_LIMIT=1000
QG_MAX_SQL_LENGTH=20000
QG_MAX_SEARCH_LENGTH=200

# Warehouse: postgres | duckdb
QG_WAREHOUSE=postgres
# QG_SQL_DIALECT=          # only if the sqlglot dialect differs from the name
QG_PG_DSN=postgresql://querygate:querygate@localhost:5432/warehouse
# DuckDB needs no server: uv sync --extra duckdb, then QG_WAREHOUSE=duckdb
QG_DUCKDB_PATH=:memory:
QG_ALLOWED_SCHEMAS=analytics
QG_STATEMENT_TIMEOUT_MS=15000
QG_MAX_PLAN_COST=5000000
# Refuse a query that reads a partitioned table without narrowing the partition
# column. Off for Postgres/DuckDB; worth turning on for BigQuery, Snowflake or
# Iceberg, where a missing partition filter costs money.
QG_REQUIRE_PARTITION_FILTER=false

# Catalog source (pick one; precedence S3 → dbt target → bundled sample)
# QG_CATALOG_S3_URI=s3://querygate-catalog/latest
# QG_CATALOG_S3_ENDPOINT=http://localhost:9000
# QG_CATALOG_DBT_TARGET_PATH=./dbt/target
# Fallback used when neither source above is set. Defaults to the sample catalog
# inside the package, so the server boots with no external dependencies.
# QG_CATALOG_LOCAL_PATH=
QG_CATALOG_REFRESH_TTL_SECONDS=900

# Retrieval (hybrid needs the embeddings extra: uv sync --extra embeddings)
QG_EMBEDDINGS_ENABLED=false
QG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where vectors live: memory (default) | qdrant (uv sync --extra qdrant).
# BM25 and rank fusion always stay in-process.
QG_VECTOR_BACKEND=memory
# QG_QDRANT_URL=http://localhost:6333
# QG_QDRANT_COLLECTION=querygate_catalog

# Result cache for get_filter_values (0 = disabled). Uses QG_REDIS_URL when set,
# else in-process. Keys always carry the caller's tenant scopes.
QG_CACHE_TTL_SECONDS=0

# Rate limiting (0 = disabled). Redis shares the limit across replicas; without
# it the limiter is per-process. Needs: uv sync --extra redis
QG_RATE_LIMIT_RPM=0
QG_RATE_LIMIT_BURST=10
# principal (per user) | tenant (per org) | global
QG_RATE_LIMIT_SCOPE=principal
# Per-tool token costs. Warehouse calls cost more than catalog lookups.
QG_RATE_LIMIT_COSTS=run_query=5,get_metric=5,get_table_stats=4,get_filter_values=3,search_catalog=1,describe_model=1,reload_catalog=10
# Allow calls through if the limiter store is unreachable.
QG_RATE_LIMIT_FAIL_OPEN=true
# QG_REDIS_URL=redis://localhost:6379/0

# Auth: static (fixed tokens, for the demo) | oidc (Keycloak/Auth0/Okta)
QG_AUTH_PROVIDER=static
# Static tokens: token=tenantA|tenantB:role1|role2
QG_DEMO_TOKENS=tok_acme=acme,tok_globex=globex,tok_multi=acme|globex:admin

# OIDC (needs: uv sync --extra oidc). The issuer is used for `iss` validation and
# for JWKS discovery. Set the audience; without it any token from the same realm
# is accepted here.
# QG_OIDC_ISSUER=http://localhost:8080/realms/querygate
# QG_OIDC_AUDIENCE=querygate
# Where tenancy/roles live in your tokens (dotted paths work for nested claims)
QG_OIDC_TENANT_CLAIM=tenant_ids
QG_OIDC_ROLES_CLAIM=realm_access.roles

# Observability (needs: uv sync --extra otel)
QG_TRACING_ENABLED=false
# QG_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Put SQL and tenant IDs in spans. Off by default: trace backends have none of
# this server's access controls. Local debugging only.
QG_TRACE_SENSITIVE=false
QG_METRICS_ENABLED=true

# Debug: attach the provenance footer to results (never on in prod)
QG_INCLUDE_PROVENANCE=false
